<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="147.0" prefWidth="1280.0" style="-fx-background-color: #;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.InsertPopUpController">
  <children>
    <HBox alignment="CENTER" prefHeight="91.0" prefWidth="1280.0">
      <children>
        <ImageView fitHeight="70.0" fitWidth="70.0" pickOnBounds="true" preserveRatio="true">
          <HBox.margin>
            <Insets right="20.0"/>
          </HBox.margin>
        </ImageView>
        <Label text="Kode:">
          <HBox.margin>
            <Insets right="5.0"/>
          </HBox.margin>
        </Label>
        <TextField fx:id="kodeBarang">
          <HBox.margin>
            <Insets right="20.0"/>
          </HBox.margin>
        </TextField>
        <Label text="Nama:">
          <HBox.margin>
            <Insets right="5.0"/>
          </HBox.margin>
        </Label>
        <TextField fx:id="namaBarang" prefWidth="400.0">
          <HBox.margin>
            <Insets right="20.0"/>
          </HBox.margin>
        </TextField>
        <Label text="Harga:">
          <HBox.margin>
            <Insets right="5.0"/>
          </HBox.margin>
        </Label>
        <TextField fx:id="hargaBarang">
          <HBox.margin>
            <Insets right="20.0"/>
          </HBox.margin>
        </TextField>
        <Label text="Stock:">
          <HBox.margin>
            <Insets right="5.0"/>
          </HBox.margin>
        </Label>
        <TextField fx:id="stokBarang">
          <HBox.margin>
            <Insets right="20.0"/>
          </HBox.margin>
        </TextField>
      </children>
    </HBox>
    <Button layoutX="1006.0" layoutY="101.0" mnemonicParsing="false" onAction="#cofimData" text="Confirm">
      <font>
        <Font name="Poppins SemiBold" size="14.0"/>
      </font>
    </Button>
    <Button layoutX="1136.0" layoutY="101.0" mnemonicParsing="false" onAction="#cencelData" text="Cancel">
      <font>
        <Font name="Poppins SemiBold" size="14.0"/>
      </font>
    </Button>
  </children>
  <padding>
    <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
  </padding>
</AnchorPane>
